#!/bin/sh
set -eu
# Official CUDA libraries and NVIDIA NCCL supplement the Flatpak driver extension.
export LD_LIBRARY_PATH="/app/extra/cudart:/app/extra/nccl/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Relative output and temporary uploads remain in persistent private app data.
cd "$XDG_DATA_HOME"
exec /app/extra/audio/audiocpp_server --ui --ui-management --backend cuda --host 127.0.0.1 --port 8083 --models-root "$XDG_DATA_HOME/models" --voice-dir "$XDG_DATA_HOME/voices" "$@"
