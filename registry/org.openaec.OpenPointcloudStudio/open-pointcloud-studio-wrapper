#!/bin/sh
set -eu

# The app is a self-contained iced + wgpu binary; it opens the GPU, Wayland,
# X11 and xkbcommon libraries of the runtime at run time and needs nothing
# set. Arguments pass through, so `--mcp` starts its MCP server.
exec /app/extra/open-pointcloud-studio/open-pointcloud-studio "$@"
