#!/bin/sh
set -eu
unset ELECTRON_RUN_AS_NODE
# Match the AppImage launcher library path and use zypak for Electron's sandbox.
export LD_LIBRARY_PATH="/app/extra/bob/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
launcher="$(cat /app/extra/launcher)"
exec zypak-wrapper "/app/extra/bob/$launcher" --ozone-platform-hint=auto "$@"
