  <name>Taobao</name>
  <name xml:lang="zh-Hans">淘宝</name>
  <summary>Shop Taobao from your Linux desktop</summary>
  <summary xml:lang="zh-Hans">淘宝桌面版：在电脑上浏览、沟通和购物</summary>
  <developer id="com.taobao">
    <name>Taobao</name>
