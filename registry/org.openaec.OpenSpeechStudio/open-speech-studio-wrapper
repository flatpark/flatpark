#!/bin/sh
set -eu

# WebKitGTK's DMABUF renderer paints a blank window under many drivers inside
# the sandbox. The main window is opaque (tauri.conf.json), so it is turned off
# by default; override with WEBKIT_DISABLE_DMABUF_RENDERER=0. The binary sets
# no WEBKIT_* variable itself.
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"

exec /app/extra/speech/usr/bin/org.openaec.OpenSpeechStudio "$@"
