#!/bin/sh
set -eu
# Upstream's Flatpak build installs corvus, corvus-cli and qrencode in /app/bin,
# qtkeychain and hunspell in /app/lib and the dictionaries in /app/share/hunspell;
# here the same tree is under /app/extra/corvus. corvus looks up corvus-cli on
# PATH.
export PATH="/app/extra/corvus/bin:$PATH"
export LD_LIBRARY_PATH="/app/extra/corvus/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /app/extra/corvus/bin/corvus "$@"
