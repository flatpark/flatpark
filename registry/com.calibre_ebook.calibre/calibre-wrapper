#!/bin/sh
set -eu

# One wrapper for every calibre entry point. It is installed as /app/bin/calibre
# and symlinked to the other launcher names, and dispatches on the name it was
# invoked under, so `flatpak run --command=ebook-convert com.calibre_ebook.calibre`
# and the exported E-book viewer / editor desktop entries all land on the right
# binary inside the bundle staged by apply_extra at /app/extra/calibre.
app="/app/extra/calibre"
cmd="${0##*/}"

[ -x "$app/$cmd" ] || { echo "calibre: no bundled command named '$cmd'" >&2; exit 127; }

# calibre's first-run library default is ~/Calibre Library, which the sandbox
# does not grant (only Documents and Downloads are). On a fresh install, before
# calibre has written any config, point library_path at Documents/Calibre
# instead; the welcome wizard then offers that location, and an existing config
# is never touched.
cfg="${CALIBRE_CONFIG_DIRECTORY:-${XDG_CONFIG_HOME:-$HOME/.config}/calibre}/global.py.json"
if [ ! -e "$cfg" ]; then
  docs=$(xdg-user-dir DOCUMENTS 2>/dev/null) || docs=
  { [ -n "$docs" ] && [ "$docs" != "$HOME" ]; } || docs="$HOME/Documents"
  lib=$(printf '%s' "$docs/Calibre" | sed 's/\\/\\\\/g; s/"/\\"/g')
  mkdir -p "${cfg%/*}"
  printf '{\n  "library_path": "%s"\n}\n' "$lib" > "$cfg"
fi

exec "$app/$cmd" "$@"
