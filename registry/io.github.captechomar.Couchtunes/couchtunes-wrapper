#!/bin/sh
set -eu

# Couchtunes is an Electron app staged by apply_extra to /app/extra/couchtunes
# from the AppDir inside the upstream AppImage. Run it through zypak-wrapper
# (from org.electronjs.Electron2.BaseApp): zypak redirects Chromium's SUID
# sandbox onto the Flatpak sandbox, so the app keeps an internal sandbox.
#
# Defensively clear ELECTRON_RUN_AS_NODE so a value leaked from the launching
# environment (a terminal inside VS Code / another Electron app) cannot make the
# binary start as plain Node instead of the GUI.
unset ELECTRON_RUN_AS_NODE

# The host's cursor themes, so the pointer matches the desktop: ~/.icons
# (granted read-only), then ~/.local/share/icons and the system icons, which
# Flatpak exposes under /run/host.
export XCURSOR_PATH="$HOME/.icons:/run/host/user-share/icons:/run/host/share/icons${XCURSOR_PATH:+:$XCURSOR_PATH}"

# Native Wayland when there is one, X11 otherwise. Upstream's own Flatpak keeps
# a switch to force X11 for desktops where Wayland misbehaves:
#   flatpak run --env=COUCHTUNES_X11=1 io.github.captechomar.Couchtunes
if [ -n "${COUCHTUNES_X11:-}" ]; then
    platform=--ozone-platform=x11
else
    platform=--ozone-platform-hint=auto
fi

# apply_extra resolves the launcher's upstream name from the AppDir's own AppRun
# and records it next to the app tree, so an upstream rename cannot break an
# automated pin refresh.
launcher="$(cat /app/extra/launcher 2>/dev/null || true)"
[ -n "$launcher" ] || launcher=couchtunes
exec zypak-wrapper "/app/extra/couchtunes/$launcher" "$platform" "$@"
