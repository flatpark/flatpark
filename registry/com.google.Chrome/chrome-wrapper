#!/bin/sh
set -eu

# Google's official Chrome build is staged by apply_extra to /app/extra/chrome
# and run through zypak-wrapper, which comes from
# org.electronjs.Electron2.BaseApp. Flatpak refuses the namespace syscalls
# Chromium's own sandbox needs, so without zypak the only way to start the
# browser is --no-sandbox — every renderer, which runs arbitrary web content,
# would then be unconfined inside the app sandbox with the whole profile in
# reach. zypak redirects Chromium's SUID sandbox onto the Flatpak sandbox
# instead, so per-renderer isolation is kept.
#
# The binary is `chrome`; `google-chrome` next to it is upstream's own shell
# launcher, whose environment is set here instead.

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"

# chrome://restart and the post-update "Relaunch" button re-exec the browser.
# CHROME_WRAPPER has to name this script or the re-exec would bypass it and
# come back up without any of the environment set here (zypak README,
# "Usage with a wrapper script").
export CHROME_WRAPPER=/app/bin/chrome
export ZYPAK_SPAWN_LATEST_ON_REEXEC=1

# What upstream's google-chrome launcher sets.
export CHROME_VERSION_EXTRA=stable
export GNOME_DISABLE_CRASH_DIALOG=SET_BY_GOOGLE_CHROME

# Chrome ships a Widevine CDM next to the binary and may download a newer one
# into the profile. zypak has to be told that path explicitly, or the
# downloaded CDM never loads.
export ZYPAK_EXPOSE_WIDEVINE_PATH="$config_dir/google-chrome/WidevineCdm"

# Media cover art is written to $TMPDIR and handed to the desktop as a file://
# URL; the sandbox's /tmp is private, so use a path that is the same inside and
# outside.
export TMPDIR="${XDG_RUNTIME_DIR}/app/${FLATPAK_ID}"

# Extra command-line flags, read from the file the Chromium family uses
# everywhere else — here ~/.var/app/com.google.Chrome/config/chrome-flags.conf.
# One flag per line, # starts a comment.
flags=""
if [ -r "$config_dir/chrome-flags.conf" ]; then
    flags="$(sed -e 's/#.*//' "$config_dir/chrome-flags.conf" | tr '\n' ' ')"
fi

# $flags is deliberately unquoted: it has to word-split into separate arguments.
# shellcheck disable=SC2086
exec zypak-wrapper /app/extra/chrome/chrome --ozone-platform-hint=auto $flags "$@"
