#!/bin/sh
set -eu

# Crash recovery keeps its session marker and auto-backups in the temporary
# folder. The sandbox's /tmp goes when the app exits; $XDG_CACHE_HOME/tmp stays.
export TMPDIR="${XDG_CACHE_HOME}/tmp"

# TraceDraw is staged by apply_extra at /app/extra/tracedraw.
exec /app/extra/tracedraw/tracedraw "$@"
