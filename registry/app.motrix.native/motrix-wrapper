#!/bin/sh
set -eu

# Motrix is an Electron app staged by apply_extra to /app/extra/motrix. Run it
# through zypak-wrapper (from org.electronjs.Electron2.BaseApp): zypak redirects
# Chromium's SUID sandbox onto the Flatpak sandbox, so the app keeps an internal
# sandbox rather than running with --no-sandbox.
# --ozone-platform-hint=auto lets Chromium use Wayland when available and fall
# back to X11. Flatpak redirects the XDG base dirs, so the app's config, its
# download database and the aria2 session stay inside the sandbox.

# Defensively clear ELECTRON_RUN_AS_NODE: if it leaks in from the launching
# environment (e.g. a terminal inside VS Code/Electron), the binary would start
# as plain Node instead of the GUI app.
unset ELECTRON_RUN_AS_NODE

# The app treats a Snap environment as a distinct packaging mode and resolves
# different helper paths for it. None of those variables describe this sandbox,
# so clear anything the launching environment leaked in. Same set upstream
# clears in their own Flatpak launcher.
unset SNAP SNAP_NAME SNAP_INSTANCE_NAME SNAP_REAL_HOME

# Route GTK's file chooser and portal-backed dialogs through xdg-desktop-portal,
# so "save to…" can reach a directory outside the --filesystem grant.
export GTK_USE_PORTAL=1

# The bundled aria2c is statically linked against a musl build of OpenSSL whose
# compiled-in OPENSSLDIR is /usr/local/x86_64-linux-musl/ssl — a path that exists
# on no real system — so it has no trust store to fall back on and every HTTPS
# download fails with "SSL/TLS handshake failure: unable to get local issuer
# certificate". Point OpenSSL at the runtime's CA bundle through the environment
# it already honours; the engine inherits this from the app process.
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
export SSL_CERT_DIR=/etc/ssl/certs

# The browser-bridge endpoint descriptor. Pin it under the app's own config dir
# rather than letting it fall back to a path that does not exist in the sandbox.
export MOTRIX_BRIDGE_DATA_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/motrix/bridge"

# Chromium writes sizeable scratch files while downloading. Keep them on the
# per-app runtime dir instead of the sandbox's small /tmp.
TMPDIR="${XDG_RUNTIME_DIR:-/tmp}/app/${FLATPAK_ID:-app.motrix.native}"
mkdir -p "$TMPDIR"
export TMPDIR

# apply_extra recorded the launcher name from the .deb's own desktop entry, so a
# rename upstream cannot leave this wrapper pointing at a binary that is gone.
launcher="$(cat /app/extra/motrix/.launcher)"

exec zypak-wrapper "/app/extra/motrix/$launcher" --ozone-platform-hint=auto "$@"
