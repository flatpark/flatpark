Icon=ely.zacharyzhang.office.mark
Terminal=false
StartupNotify=true
StartupWMClass=ely-mark
Categories=Utility;TextEditor;
MimeType=text/markdown;
Keywords=markdown;md;editor;notes;typora;math;mermaid;
