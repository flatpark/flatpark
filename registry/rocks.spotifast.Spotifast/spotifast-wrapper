#!/bin/sh
set -eu

# spotifast is staged by apply_extra at /app/extra/spotifast, with the
# resolved executable path recorded in app.env.
[ -f /app/extra/app.env ] || {
  echo "spotifast: /app/extra/app.env is missing, reinstall the app" >&2
  exit 1
}
# shellcheck source=/dev/null  # written by apply_extra at install time
. /app/extra/app.env

exec "$APP_BIN" "$@"
