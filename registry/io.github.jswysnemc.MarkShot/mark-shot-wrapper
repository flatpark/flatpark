#!/bin/sh
set -eu

# Mark Shot is upstream's portable tarball, unpacked by apply_extra into
# /app/extra/mark-shot. The executable links only runtime libraries and finds
# its recorder (usr/lib/mark-shot/media) next to itself through
# /proc/self/exe, so nothing is added to LD_LIBRARY_PATH or PATH here.
#
# It picks Wayland or X11 from WAYLAND_DISPLAY / DISPLAY itself, and settings,
# capture history and the OCR runtime it downloads on first use live under
# ~/.var/app/io.github.jswysnemc.MarkShot via the usual XDG variables.
exec /app/extra/mark-shot/usr/lib/mark-shot/mark-shot "$@"
