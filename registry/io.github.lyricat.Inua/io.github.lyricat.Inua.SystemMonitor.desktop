[Desktop Entry]
Type=Application
Name=System Monitor
Name[es]=Monitor del sistema
Name[fr]=Moniteur système
Name[ja]=システムモニター
Name[ko]=시스템 모니터
Name[zh_CN]=系统监视器
Name[zh_TW]=系統監視器
Comment=CPU, memory, network, disk, battery and processes
Comment[es]=CPU, memoria, red, disco, batería y procesos
Comment[fr]=CPU, mémoire, réseau, disque, batterie et processus
Comment[ja]=CPU、メモリ、ネットワーク、ディスク、バッテリー、およびプロセス
Comment[ko]=CPU, 메모리, 네트워크, 디스크, 배터리 및 프로세스
Comment[zh_CN]=CPU、内存、网络、磁盘、电池和进程
Comment[zh_TW]=CPU、記憶體、網路、磁碟、電池和進程
Exec=inua-apps system-monitor
Icon=io.github.lyricat.Inua.SystemMonitor
Categories=System;Monitor;
Keywords=cpu;memory;process;task;usage;
Keywords[es]=cpu;memoria;proceso;tarea;uso;
Keywords[fr]=cpu;processeur;mémoire;processus;tâche;utilisation;
Keywords[ja]=cpu;メモリ;プロセス;タスク;使用率;
Keywords[ko]=cpu;메모리;프로세스;작업;사용량;
Keywords[zh_CN]=cpu;内存;进程;任务;使用情况;
Keywords[zh_TW]=cpu;記憶體;處理程序;工作;使用率;
StartupWMClass=io.github.lyricat.Inua.SystemMonitor
StartupNotify=true
