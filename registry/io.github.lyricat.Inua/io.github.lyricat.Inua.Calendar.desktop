[Desktop Entry]
Type=Application
Name=Calendar
Name[es]=Calendario
Name[fr]=Calendrier
Name[ja]=カレンダー
Name[ko]=달력
Name[zh_CN]=日历
Name[zh_TW]=日曆
Comment=The month, week numbers and your events
Comment[es]=El mes, los números de la semana y sus eventos.
Comment[fr]=Les numéros de mois, de semaines et vos événements
Comment[ja]=月、週番号、イベント
Comment[ko]=월, 주 번호 및 이벤트
Comment[zh_CN]=月份、周数和您的事件
Comment[zh_TW]=月份、週數和您的事件
Exec=inua-apps calendar
Icon=io.github.lyricat.Inua.Calendar
Categories=Office;Calendar;
Keywords=date;event;month;schedule;
Keywords[es]=fecha;evento;mes;horario;
Keywords[fr]=date;événement;mois;agenda;
Keywords[ja]=日付;イベント;月;スケジュール;
Keywords[ko]=날짜;이벤트;월;일정;
Keywords[zh_CN]=日期;事件;月份;日程;
Keywords[zh_TW]=日期;事件;月份;行程;
StartupWMClass=io.github.lyricat.Inua.Calendar
StartupNotify=true
