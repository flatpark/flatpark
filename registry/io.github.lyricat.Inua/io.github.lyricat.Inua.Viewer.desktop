[Desktop Entry]
Type=Application
Name=Viewer
Name[es]=Visor
Name[fr]=Visionneuse
Name[ja]=ビューアー
Name[ko]=뷰어
Name[zh_CN]=查看器
Name[zh_TW]=檢視器
Comment=Look through pictures, PDFs, Markdown and text
Comment[es]=Mirar imágenes, PDF, Markdown y texto
Comment[fr]=Parcourir images, PDF, Markdown et texte
Comment[ja]=画像、PDF、Markdown、テキストを見る
Comment[ko]=사진, PDF, Markdown, 텍스트 보기
Comment[zh_CN]=翻看图片、PDF、Markdown 和文本
Comment[zh_TW]=翻閱圖片、PDF、Markdown 和文字
Exec=inua-viewer %F
Icon=io.github.lyricat.Inua.Viewer
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;Office;
Keywords=image;picture;photo;viewer;pdf;document;markdown;text;
Keywords[es]=imagen;foto;fotografía;visor;pdf;documento;markdown;texto;
Keywords[fr]=image;photo;visionneuse;pdf;document;markdown;texte;
Keywords[ja]=画像;写真;ビューア;PDF;文書;Markdown;テキスト;
Keywords[ko]=이미지;그림;사진;뷰어;PDF;문서;마크다운;텍스트;
Keywords[zh_CN]=图像;图片;照片;看图;查看器;PDF;文档;Markdown;文本;
Keywords[zh_TW]=圖像;圖片;照片;看圖;檢視器;PDF;文件;Markdown;文字;
MimeType=application/pdf;image/avif;image/bmp;image/gif;image/heic;image/heif;image/jpeg;image/jxl;image/png;image/svg+xml;image/tiff;image/vnd.microsoft.icon;image/webp;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;image/x-xpixmap;text/markdown;
StartupWMClass=io.github.lyricat.Inua.Viewer
StartupNotify=true
