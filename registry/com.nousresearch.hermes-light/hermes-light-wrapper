#!/bin/sh
set -eu

# Hermes Light is an Electron app staged by apply_extra to /app/extra/hermes-light
# from the AppDir inside the pinned AppImage. Run it through zypak-wrapper
# (from org.electronjs.Electron2.BaseApp): zypak redirects Chromium's SUID
# sandbox onto the Flatpak sandbox, so the app keeps an internal sandbox.
# --ozone-platform-hint=auto lets Chromium pick Wayland when available and fall
# back to X11.
#
# LD_LIBRARY_PATH mirrors what the AppDir's own AppRun sets, so the handful of
# libraries the bundle carries for older hosts (libnotify, libXtst, libXss,
# libgconf and the appindicator trio) resolve exactly as they do outside
# Flatpak. The AppRun's other exports (XDG_DATA_DIRS for the bundle's icons,
# GSETTINGS_SCHEMA_DIR) are skipped: this package exports its own desktop entry
# and icon at build time, and the bundle carries no GSettings schemas.
#
# Defensively clear ELECTRON_RUN_AS_NODE so a value leaked from the launching
# environment (a terminal inside VS Code / another Electron app) cannot make the
# binary start as plain Node instead of the GUI.
unset ELECTRON_RUN_AS_NODE

# Chromium writes the tray icon (and media cover art) to files in $TMPDIR and
# hands the tray host that directory; the sandbox's /tmp is private, so the
# host can't read the file and the item shows a placeholder or nothing. Point
# TMPDIR at the per-app runtime dir, which is the same path inside and outside
# the sandbox (com.openai.ChatGPT is the precedent). Never grant /tmp. The
# tray only appears once "minimize to tray" is enabled in the app's settings —
# the feature is off by default (tray starts disabled in electron-main.mjs).
export TMPDIR="${XDG_RUNTIME_DIR}/app/${FLATPAK_ID}"

export LD_LIBRARY_PATH="/app/extra/hermes-light/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# apply_extra resolves the launcher's upstream name from the AppDir's own AppRun
# and records it next to the app tree, so an upstream rename cannot break an
# automated pin refresh.
launcher="$(cat /app/extra/launcher 2>/dev/null || true)"
[ -n "$launcher" ] || launcher="Hermes Light"

# The recorded name can contain spaces (upstream's electron-builder keeps
# "Hermes Light" as the executable name); the path is quoted as a whole.
exec zypak-wrapper "/app/extra/hermes-light/$launcher" --ozone-platform-hint=auto "$@"
