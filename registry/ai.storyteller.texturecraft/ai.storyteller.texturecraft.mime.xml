<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definitions for TextureCraft's project format and the mesh formats it opens,
     for systems whose database is missing them (shared-mime-info merges duplicate definitions).
     Installed to /usr/share/mime/packages/ (update-mime-database runs on install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-texturecraft">
    <comment>TextureCraft project</comment>
    <sub-class-of type="application/zip"/>
    <icon name="ai.storyteller.texturecraft"/>
    <glob pattern="*.tcraft" weight="60"/>
  </mime-type>
  <mime-type type="model/gltf-binary">
    <comment>glTF binary model</comment>
    <magic priority="50">
      <match type="string" value="glTF" offset="0"/>
    </magic>
    <glob pattern="*.glb"/>
  </mime-type>
  <mime-type type="model/gltf+json">
    <comment>glTF model</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.gltf"/>
  </mime-type>
  <mime-type type="model/x-fbx">
    <comment>FBX model</comment>
    <magic priority="50">
      <match type="string" value="Kaydara FBX Binary" offset="0"/>
    </magic>
    <glob pattern="*.fbx"/>
  </mime-type>
  <mime-type type="model/vnd.collada+xml">
    <comment>COLLADA model</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.dae"/>
  </mime-type>
  <mime-type type="model/x-usd">
    <comment>Universal Scene Description</comment>
    <magic priority="50">
      <match type="string" value="PXR-USDC" offset="0"/>
      <match type="string" value="#usda" offset="0"/>
    </magic>
    <glob pattern="*.usd"/>
    <glob pattern="*.usdc"/>
  </mime-type>
  <mime-type type="model/vnd.usda">
    <comment>Universal Scene Description (text)</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.usda"/>
  </mime-type>
  <mime-type type="model/vnd.usdz+zip">
    <comment>Universal Scene Description package</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.usdz"/>
  </mime-type>
  <!-- *.abc is also ABC music notation; the Ogawa magic tells Alembic caches apart. -->
  <mime-type type="model/x-alembic">
    <comment>Alembic model</comment>
    <magic priority="60">
      <match type="string" value="Ogawa" offset="0"/>
    </magic>
    <glob pattern="*.abc"/>
  </mime-type>
  <mime-type type="model/obj">
    <comment>Wavefront OBJ model</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.obj"/>
  </mime-type>
  <mime-type type="model/x-ply">
    <comment>PLY model</comment>
    <magic priority="50">
      <match type="string" value="ply\n" offset="0"/>
      <match type="string" value="ply\r\n" offset="0"/>
    </magic>
    <glob pattern="*.ply"/>
  </mime-type>
  <mime-type type="model/stl">
    <comment>STL model</comment>
    <glob pattern="*.stl"/>
  </mime-type>
</mime-info>
