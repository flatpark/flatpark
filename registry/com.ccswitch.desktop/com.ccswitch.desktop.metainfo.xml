  <id>com.ccswitch.desktop</id>
  <name>CC Switch</name>
  <summary>All-in-One assistant for switching Claude Code, Codex and Gemini CLI configs</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="com.ccswitch">
    <name>farion1231</name>
