[Desktop Entry]
Type=Application
Name=PiliPlus
Comment=A third-party Bilibili client developed in Flutter
Comment[zh_CN]=使用 Flutter 开发的 BiliBili 第三方客户端
Exec=piliplus %u
Icon=io.github.bggRGjQaUbCoE.PiliPlus
Terminal=false
StartupWMClass=com.example.piliplus
Categories=AudioVideo;Video;Player;
MimeType=x-scheme-handler/bilibili;
