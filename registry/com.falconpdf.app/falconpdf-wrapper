#!/bin/sh
set -eu

# Falcon PDF is a jpackage bundle staged by apply_extra to
# /app/extra/falconpdf; upstream's `falconpdf` launcher starts bin/FalconPDF,
# which runs the bundled Java runtime with lib/app/FalconPDF.cfg. The library
# database goes to $XDG_CONFIG_HOME, which Flatpak redirects under
# ~/.var/app/com.falconpdf.app.
#
# /app/lib holds only the libcrypt.so.1 link the PDF engine asks for (see the
# manifest); ldconfig does not index it under that name, so name the directory.
export LD_LIBRARY_PATH="/app/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /app/extra/falconpdf/falconpdf "$@"
