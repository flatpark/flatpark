#!/bin/sh
set -eu

# WebKitGTK's DMABUF renderer paints a blank window under many drivers inside
# the sandbox. The window is opaque and the app sets no WEBKIT_ variable of its
# own. Override with WEBKIT_DISABLE_DMABUF_RENDERER=0 to use it.
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"

exec /app/extra/planner/usr/bin/org.openaec.planner "$@"
