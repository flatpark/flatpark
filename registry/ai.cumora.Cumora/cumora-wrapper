#!/bin/sh
set -eu

# Cumora is staged by apply_extra to /app/extra/cumora, and the resolved binary
# name is recorded in app.env at install time. Run it through zypak-wrapper
# (from org.electronjs.Electron2.BaseApp): zypak redirects Chromium's SUID
# sandbox onto the Flatpak sandbox, so renderer and GPU processes stay isolated
# without the Debian package's chrome-sandbox postinst and without --no-sandbox.
#
# Keep this wrapper thin so the upstream application tree stays unmodified:
# display, file dialogs and the Chromium sandbox are handled by portals/zypak
# and the manifest permissions.
[ -f /app/extra/app.env ] || {
  echo "cumora: /app/extra/app.env is missing, reinstall the app" >&2
  exit 1
}
# shellcheck source=/dev/null  # written by apply_extra at install time
. /app/extra/app.env

# Defensively clear ELECTRON_RUN_AS_NODE: if it leaks in from the launching
# environment (e.g. a terminal inside VS Code/Electron), the binary would start
# as plain Node instead of the GUI app.
unset ELECTRON_RUN_AS_NODE

# Chromium writes the tray icon and media cover art to files in $TMPDIR and
# hands the desktop their paths; the sandbox's /tmp is private, so the host
# can't read them. Point TMPDIR at the per-app runtime dir, which is the same
# path inside and outside.
export TMPDIR="${XDG_RUNTIME_DIR}/app/${FLATPAK_ID}"

# --enable-wayland-ime: without it a Wayland session gets no input-method
# window, which breaks CJK input in the message composer.
exec zypak-wrapper "$APP_BIN" --ozone-platform-hint=auto --enable-wayland-ime "$@"
