#!/bin/sh
set -eu

# Qoder is an Electron app staged by apply_extra to /app/extra/qoder-ide. Run it
# through zypak-wrapper from org.electronjs.Electron2.BaseApp so Chromium keeps
# its internal sandbox inside Flatpak. --ozone-platform-hint=auto lets Chromium
# use Wayland when available and fall back to X11.

unset ELECTRON_RUN_AS_NODE

extra_root=/app/extra
launcher_file="$extra_root/qoder-ide-launcher"
launcher="qoder-ide"
if [ -r "$launcher_file" ]; then
  read -r recorded < "$launcher_file" || recorded=""
  [ -n "$recorded" ] && launcher="$recorded"
fi

# Launch by absolute path and leave the working directory alone: it is
# inherited by the processes the editor spawns.
exec zypak-wrapper "$extra_root/qoder-ide/$launcher" --ozone-platform-hint=auto "$@"
