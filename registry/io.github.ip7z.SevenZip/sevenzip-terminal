#!/bin/sh
set -eu
# Keep the terminal open with the packaged command on PATH for menu launches.
printf '%s\n' '7-Zip for Linux — console version' \
  'Use 7zz to compress, list, test and extract archives; 7zz -h shows help.' \
  'Files in your home folder are accessible. Type exit to close this terminal.'
exec /bin/sh -i
