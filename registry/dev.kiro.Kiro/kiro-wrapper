#!/bin/sh
set -eu

# Kiro is an Electron app staged by apply_extra to /app/extra/kiro. Run it
# through zypak-wrapper from org.electronjs.Electron2.BaseApp so Chromium keeps
# its internal sandbox inside Flatpak. --ozone-platform-hint=auto lets Chromium
# use Wayland when available and fall back to X11. --disable-updates switches
# off the built-in update check (upstream ships an updateUrl; the sandbox cannot
# install updates anyway, they arrive through flatpak update instead).

unset ELECTRON_RUN_AS_NODE

extra_root=/app/extra
launcher_file="$extra_root/kiro-launcher"
launcher="kiro"
if [ -r "$launcher_file" ]; then
  read -r recorded < "$launcher_file" || recorded=""
  [ -n "$recorded" ] && launcher="$recorded"
fi

# Launch by absolute path and leave the working directory alone: it is
# inherited by the processes the editor spawns.
exec zypak-wrapper "$extra_root/kiro/$launcher" --ozone-platform-hint=auto --disable-updates "$@"
