[Desktop Entry]
Type=Application
Name=Kiro
GenericName=AI IDE
Comment=The spec-driven agentic IDE
Exec=kiro %F
Icon=dev.kiro.Kiro
Terminal=false
StartupNotify=true
StartupWMClass=Kiro
Categories=Development;IDE;TextEditor;
MimeType=application/x-kiro-workspace;
Keywords=kiro;ai;agent;editor;ide;code;spec;
Actions=new-empty-window;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=kiro --new-window %F
Icon=dev.kiro.Kiro
