<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.tunaos.blueshell</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT AND GPL-3.0-or-later</project_license>
  <name>Blueshell</name>
  <summary>Container-native terminal powered by Ghostty</summary>
  <description>
    <p>
      Blueshell combines Ghostty's rendering engine with a GNOME terminal
      interface and first-class support for Toolbox, Distrobox, and Podman
      containers.
    </p>
  </description>
  <url type="homepage">https://github.com/tuna-os/blueshell</url>
  <url type="bugtracker">https://github.com/tuna-os/blueshell/issues</url>
  <url type="vcs-browser">https://github.com/tuna-os/blueshell</url>
  <developer id="org.tunaos">
    <name>TunaOS</name>
  </developer>

  <launchable type="desktop-id">org.tunaos.blueshell.desktop</launchable>
  <provides>
    <binary>blueshell</binary>
  </provides>
  <content_rating type="oars-1.1" />

  <!-- Without these a store shows "Desktop Only" and cannot say the app fits
       the viewer's device. -->
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <releases>
    <release version="1.3.1" date="2026-10-14">
      <description>
        <p>First versioned Blueshell release, matching Ghostty v1.3.1.</p>
      </description>
    </release>
  </releases>
</component>
