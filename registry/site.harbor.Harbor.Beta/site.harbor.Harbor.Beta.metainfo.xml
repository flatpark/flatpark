<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>site.harbor.Harbor.Beta</id>
  <name>Harbor Beta</name>
  <summary>Beta channel of a Stremio client built for adventure</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="site.harbor">
    <name>Harbor Developers</name>
  </developer>
  <url type="homepage">https://harbor.site/</url>
  <url type="bugtracker">https://github.com/harborstremio/harbor/issues</url>
  <url type="vcs-browser">https://github.com/harborstremio/harbor</url>
  <description>
    <p>Harbor Beta is the preview channel of Harbor, a desktop media client for browsing and playing content from Stremio addons.</p>
    <p>This package follows Harbor's beta releases and may contain changes that have not yet reached the stable channel.</p>
  </description>
  <launchable type="desktop-id">site.harbor.Harbor.Beta.desktop</launchable>
  <provides>
    <binary>harbor-beta</binary>
    <mediatype>x-scheme-handler/harbor</mediatype>
    <mediatype>x-scheme-handler/stremio</mediatype>
  </provides>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Player</category>
  </categories>
  <keywords>
    <keyword>stremio</keyword>
    <keyword>media</keyword>
    <keyword>video</keyword>
    <keyword>player</keyword>
    <keyword>beta</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
  <screenshots>
    <screenshot type="default">
      <caption>Harbor media client</caption>
      <image>https://harbor.site/readme-media/hero.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.9.117-5" date="2026-08-04">
      <description></description>
    </release>
    <release version="0.9.117-3" date="2026-08-04">
      <description>
        <p>Harbor Beta 0.9.117. See the upstream release notes for details.</p>
      </description>
    </release>
    <release version="0.9.115" date="2026-07-29" />
  </releases>
</component>
