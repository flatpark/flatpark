#!/bin/sh
set -eu

# Mister Download Manager is a self-contained Rust program (its own GPU-drawn
# toolkit; Wayland, X11, EGL/Vulkan and libdbus are dlopen-ed from the
# runtime), staged by apply_extra at /app/extra/mdm. Its list, settings and
# command channel go to the XDG data dir, which Flatpak points at
# ~/.var/app/com.misterdownloadmanager.MisterDownloadManager.
exec /app/extra/mdm/misterdownloadmanager "$@"
