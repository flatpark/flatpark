#!/bin/sh
set -eu
# Deno runs the EJS scripts bundled in upstream's ZIP; no remote code is needed.
export PATH="/app/extra/deno:$PATH"
export DENO_NO_UPDATE_CHECK=1
# The onedir build cannot replace itself; explicit -U can still check releases.
# --no-update also suppresses routine checks and the 90-day age warning.
exec /app/extra/yt-dlp/launcher --no-update "$@"
