#!/bin/sh
set -eu

# ChatGPT is staged by apply_extra to /app/extra/chatgpt, and the resolved
# binary name is recorded in app.env at install time. Run it through
# zypak-wrapper (from org.electronjs.Electron2.BaseApp): zypak redirects
# Chromium's SUID sandbox onto the Flatpak sandbox, so renderer and GPU
# processes stay isolated without the Debian package's chrome-sandbox postinst
# and without --no-sandbox.
#
# Keep this wrapper thin so the upstream application tree stays unmodified:
# display, credential storage and the Chromium sandbox are handled by
# portals/zypak and the manifest permissions.
[ -f /app/extra/app.env ] || {
  echo "chatgpt: /app/extra/app.env is missing, reinstall the app" >&2
  exit 1
}
# shellcheck source=/dev/null  # written by apply_extra at install time
. /app/extra/app.env

unset ELECTRON_RUN_AS_NODE

# Chromium writes the tray icon to $TMPDIR and hands the tray host that path;
# the sandbox's /tmp is private, so the host shows a placeholder. Point TMPDIR
# at the per-app runtime dir, which is the same path inside and outside.
export TMPDIR="${XDG_RUNTIME_DIR}/app/${FLATPAK_ID}"

exec zypak-wrapper "$APP_BIN" --ozone-platform-hint=auto --enable-wayland-ime "$@"
