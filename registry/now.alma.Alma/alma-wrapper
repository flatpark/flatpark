#!/bin/sh
set -eu

# Alma (native Go + WebKitGTK 4.1 since 0.4.491) is staged by apply_extra to
# /app/extra/alma. WebKitGTK's DMABUF renderer leaves the window blank on many
# GPUs inside the sandbox; written as ${VAR:-1} so a user can flip it back with
# `flatpak override --env=WEBKIT_DISABLE_DMABUF_RENDERER=0`. Flatpak redirects
# $HOME, so the app's config and memory database stay sandboxed.
# The launcher still honours a leaked ELECTRON_RUN_AS_NODE and turns into plain
# Node (no window); the manifest unsets it too, this covers `flatpak run --env`.
unset ELECTRON_RUN_AS_NODE
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"
# The tray writes its icon to $TMPDIR/mygo-tray-*/ and hands that directory to
# the host's tray. The sandbox's /tmp is private, so point TMPDIR at the
# per-app runtime dir, which has the same path inside and outside.
export TMPDIR="$XDG_RUNTIME_DIR/app/$FLATPAK_ID"
exec /app/extra/alma/alma "$@"
