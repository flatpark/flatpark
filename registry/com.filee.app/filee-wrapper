#!/bin/sh
set -eu
# A file-picker grant covers the selected document, not arbitrary sibling files.
# On first run, save converted files to the granted Downloads directory instead
# of the document portal's temporary view. Also turn off the in-app update
# check: Flatpak updates the app, and upstream's notice would point at the
# portable download instead. Downloaded engines still show "update available"
# on the Engines page. Keep existing settings untouched.
# Filee 2.5's portable marker would store data beside the apphost, which is
# read-only in Flatpak. Use the existing per-app settings path to preserve
# profiles from earlier releases, unless the user chose another data directory.
export FILEE_DATA_DIR="${FILEE_DATA_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/Filee}"
settings_dir="$FILEE_DATA_DIR"
settings="$settings_dir/settings.json"
if [ ! -e "$settings" ]; then
    mkdir -p "$settings_dir"
    seed="$(mktemp "$settings_dir/.flatpark-settings.XXXXXX")"
    jq -n --arg output "$(xdg-user-dir DOWNLOAD)" \
        '{checkForUpdates:false,
          defaultOutput:{location:"CustomFolder",customFolder:$output}}' > "$seed"
    # Publish a complete settings file without replacing one another launch made.
    ln "$seed" "$settings" 2>/dev/null || [ -e "$settings" ]
    rm -f "$seed"
fi
# The portable apphost resolves its bundled .NET runtime and engines itself.
exec /app/extra/filee/desktop-launcher "$@"
