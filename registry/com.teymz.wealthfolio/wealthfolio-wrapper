#!/bin/sh
set -eu

# Wealthfolio is a single Tauri/WebKitGTK binary staged by apply_extra at
# /app/extra/wealthfolio. Every library it links is supplied by
# org.gnome.Platform (webkit2gtk-4.1, gtk-3, libsoup-3, javascriptcoregtk-4.1,
# dbus-1, lzma). Flatpak redirects $HOME, so the portfolio database and settings
# stay in ~/.var/app/com.teymz.wealthfolio.

# WebKitGTK's DMABUF renderer paints a blank window under many drivers inside
# the Flatpak sandbox — disabling it is the reliable default for Tauri apps here.
export WEBKIT_DISABLE_DMABUF_RENDERER=1

exec /app/extra/wealthfolio "$@"
