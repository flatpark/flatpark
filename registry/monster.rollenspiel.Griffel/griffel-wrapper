#!/bin/sh
set -eu

# Starts the app from the unpacked payload. The GNOME runtime provides the
# interpreter and the GTK 4 / libadwaita / GtkSourceView 5 / WebKitGTK 6 stack;
# the two Python packages the runtime does not guarantee travel in vendor/.
#
# GRIFFEL_DATADIR and GRIFFEL_LOCALEDIR are the hooks griffel.paths looks at
# first, so the payload finds its own style.css, icons and message catalog even
# though they live outside /app/share. The payload also carries the GSettings
# schema, but that copy is unused: glib only looks for schemas on
# XDG_DATA_DIRS, so the one compiled at build time under /app/share is what the
# app reads.

payload=/app/extra/griffel

export PYTHONPATH="$payload:$payload/vendor"
export GRIFFEL_DATADIR="$payload/share/griffel"
export GRIFFEL_LOCALEDIR="$payload/share/locale"

# -P keeps the working directory off sys.path: a folder called griffel/ in the
# user's home must not shadow the payload.
exec python3 -P -m griffel "$@"
