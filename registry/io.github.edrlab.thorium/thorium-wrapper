#!/bin/sh
set -eu

# Electron app staged by apply_extra to /app/extra/app, started through the
# `launch` symlink apply_extra created for the launcher binary the vendor's
# .desktop names. zypak-wrapper (from org.electronjs.Electron2.BaseApp)
# redirects Chromium's SUID sandbox onto the Flatpak sandbox, so the app keeps
# an internal sandbox instead of running with --no-sandbox.
# --ozone-platform-hint=auto uses Wayland when available and falls back to X11.
# Electron keeps its settings and the publication library under
# $XDG_CONFIG_HOME, which Flatpak points at
# ~/.var/app/io.github.edrlab.thorium/config.
#
# Clear every ELECTRON_* variable inherited from the launching environment.
# A terminal inside VS Code or another Electron app exports some
# (ELECTRON_RUN_AS_NODE, ELECTRON_NO_ATTACH_CONSOLE, ...), and Thorium's
# packaged build exits at start-up, silently and with status 0, when it finds
# any ELECTRON_* variable in its environment.
for var in $(env | sed -n 's/^\(ELECTRON_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$var"
done
exec zypak-wrapper /app/extra/app/launch --ozone-platform-hint=auto "$@"
