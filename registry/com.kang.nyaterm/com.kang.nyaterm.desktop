[Desktop Entry]
Name=NyaTerm
GenericName=Remote Terminal
Comment=SSH, SFTP, Telnet, serial, RDP and VNC client
Exec=nyaterm %U
Icon=com.kang.nyaterm
Type=Application
Categories=Network;RemoteAccess;TerminalEmulator;
MimeType=x-scheme-handler/nyaterm;x-scheme-handler/ssh;x-scheme-handler/telnet;
Keywords=ssh;sftp;telnet;serial;rdp;vnc;terminal;
StartupWMClass=nyaterm
StartupNotify=true
