#!/bin/sh
set -eu

# Flow is a Tauri (WebKitGTK) app staged by apply_extra under /app/extra/flow/usr,
# with its resource tree next to the binary. Its window is opaque and it has no
# tray icon.
#
# Flow already turns off WebKitGTK's DMABUF renderer by itself and, if a launch
# fails to render, escalates its own GPU workarounds on the next start, so the
# wrapper sets nothing; any of those variables can still be set with
# `flatpak override --env=`.
exec /app/extra/flow/usr/bin/io.github.aedev.flow.desktop "$@"
