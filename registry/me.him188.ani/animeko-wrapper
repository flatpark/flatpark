#!/bin/sh
set -eu

# Animeko is a Java/Compose application staged by apply_extra to
# /app/extra/app. Start it through zypak-wrapper (from
# org.electronjs.Electron2.BaseApp): the app embeds JCEF/Chromium, and zypak
# redirects CEF's own sandbox onto Flatpak's instead of failing to create a
# nested user namespace. No --no-sandbox: the app segfaults with that flag and
# zypak is the supported route.
#
# These are the variables upstream's AppRun sets; run Ani directly so zypak
# wraps the process that starts the JVM and, through it, JCEF's helpers.
APPDIR=/app/extra/app
export APPDIR
export PATH="$APPDIR/usr/bin:$PATH"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/app${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:/app/share:/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# JCEF forces CEF onto X11 in its own arguments; the manifest grants the X11
# socket. The Compose/AWT window also runs on XWayland.
#
# JCEF's remote-server locator derives cef_server's path from a jbr-style
# runtime layout when the process was started by a native launcher. In this
# AppDir the server and helper live under usr/lib/runtime/lib, so point JCEF at
# them explicitly; without it CefApp initialization dies with
# NoSuchElementException from NativeServerManager. This only corrects a path,
# not the app's own files.
export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }-DALT_CEF_SERVER_PATH=$APPDIR/usr/lib/runtime/lib/cef_server -DALT_SUBPROCESS_PATH=$APPDIR/usr/lib/runtime/lib/jcef_helper"

exec zypak-wrapper "$APPDIR/usr/bin/Ani" "$@"
