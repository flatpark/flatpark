#!/bin/sh
set -eu

# The AppDir staged by apply_extra. Its AppRun runs the bundled Python against
# the bundled novelwriter entry point, both located relative to $APPDIR, which
# AppRun derives from its own path when APPIMAGE is unset — as it is here.
# Settings go to $XDG_CONFIG_HOME/novelwriter, inside the per-app directory.
#
# Spell checking: the bundled pyenchant loads the runtime's libenchant-2, which
# finds the runtime's hunspell dictionaries. Point it at the library directly
# rather than relying on ctypes' library search.
export PYENCHANT_LIBRARY_PATH="${PYENCHANT_LIBRARY_PATH:-/usr/lib/x86_64-linux-gnu/libenchant-2.so.2}"

exec /app/extra/novelwriter/AppRun "$@"
