#!/bin/sh
set -eu
# The official build embeds Python; Tk comes from the pinned support packages.
export LD_LIBRARY_PATH="/app/extra/tcltk/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Expose the bundled tools to EPLaunch workflows without using host programs.
export PATH="/app/extra/energyplus:/app/extra/energyplus/PostProcess:$PATH"
exec /app/extra/energyplus/energyplus "$@"
