#!/bin/sh
set -eu

# AstroBurst is a Tauri (WebKitGTK) app staged by apply_extra to
# /app/extra/astroburst. Its settings go to the XDG config dir Flatpak
# redirects under ~/.var/app/io.github.samuelkriegerbonini_dev.AstroBurst.
#
# WebKitGTK's DMABUF renderer paints a blank window under many drivers inside
# the Flatpak sandbox; the compositing path is the reliable default here.
# Written as a default so `flatpak override --env=WEBKIT_DISABLE_DMABUF_RENDERER=0`
# still takes it back.
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"
exec /app/extra/astroburst/astroburst "$@"
