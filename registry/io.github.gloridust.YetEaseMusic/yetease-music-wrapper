#!/bin/sh
set -eu

# The Flutter bundle is relocatable and finds its engine and the Rust core
# through the launcher's own RUNPATH ($ORIGIN/lib), so no LD_LIBRARY_PATH is
# needed. Flatpak redirects HOME and the XDG directories into the sandbox, so
# the login session, settings, logs and the audio cache land in
# ~/.var/app/io.github.gloridust.YetEaseMusic. The launcher name is whatever
# apply_extra found in the official archive.
extra_root=/app/extra
launcher="$(cat "$extra_root/yetease-launcher")"

exec "$extra_root/bundle/$launcher" "$@"
