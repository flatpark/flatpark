<component type="desktop-application">
  <id>io.github.FortoGraphy.Prism</id>
  <name>Prism Download Manager</name>
  <summary>Multi-connection download manager</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="dev.prism.manager">
    <name>Jan Sechovec and Prism contributors</name>
  </developer>
  <description>
    <p>Prism downloads files using multiple connections, supports queues, and resumes interrupted downloads.</p>
    <p>This community package repackages the official upstream build unmodified. Browser integration and media tools have not yet been verified in this package.</p>
  </description>
  <url type="homepage">https://prismdl.site/</url>
  <url type="bugtracker">https://github.com/FortoGraphy/prism-download-manager/issues</url>
