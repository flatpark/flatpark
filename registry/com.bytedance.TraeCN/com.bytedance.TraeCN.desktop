[Desktop Entry]
Type=Application
Name=Trae CN
GenericName=AI IDE
Comment=TRAE, The Real AI Engine
Exec=trae-cn %F
Icon=com.bytedance.TraeCN
Terminal=false
StartupNotify=true
StartupWMClass=Trae CN
Categories=Development;IDE;TextEditor;
MimeType=application/x-trae-cn-workspace;
Keywords=trae;ai;agent;editor;ide;code;
Actions=new-empty-window;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=trae-cn --new-window %F
Icon=com.bytedance.TraeCN
