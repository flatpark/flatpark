#!/bin/sh
set -eu

# P3X OneNote is an Electron app staged by apply_extra to /app/extra/app from
# the AppDir inside the upstream AppImage. Run it through zypak-wrapper (from
# org.electronjs.Electron2.BaseApp): zypak redirects Chromium's SUID sandbox
# onto the Flatpak sandbox, so the app keeps an internal sandbox instead of the
# --no-sandbox the AppImage's own desktop entry passes. --ozone-platform-hint=auto
# lets Chromium pick Wayland when available and fall back to X11.
#
# LD_LIBRARY_PATH mirrors what the AppDir's own AppRun sets, so the few
# libraries the bundle carries for older hosts (libnotify, libXss, libXtst and
# the appindicator set) resolve exactly as they do outside Flatpak. TMPDIR is
# what upstream's own Flatpak build sets, so temporary files land in the
# app's runtime directory, which the desktop's portals can reach.
#
# Defensively clear ELECTRON_RUN_AS_NODE so a value leaked from the launching
# environment (a terminal inside VS Code, for instance) cannot make the binary
# start as plain Node instead of the GUI.
unset ELECTRON_RUN_AS_NODE

export LD_LIBRARY_PATH="/app/extra/app/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export TMPDIR="$XDG_RUNTIME_DIR/app/$FLATPAK_ID"

# apply_extra resolves the launcher's upstream name from the AppDir's own AppRun
# and records it next to the app tree, so an upstream rename cannot break an
# automated pin refresh.
launcher="$(cat /app/extra/launcher 2>/dev/null || true)"
[ -n "$launcher" ] || launcher=p3x-onenote
exec zypak-wrapper "/app/extra/app/$launcher" --ozone-platform-hint=auto "$@"
