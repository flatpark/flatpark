#!/bin/sh
set -eu

# WebKitGTK's DMABUF renderer paints a blank window under many drivers inside
# the sandbox. The window is opaque (no "transparent" in tauri.conf.json), so
# it is turned off by default; override with WEBKIT_DISABLE_DMABUF_RENDERER=0.
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"

exec /app/extra/paint/usr/bin/org.openaec.OpenPaintStudio "$@"
