<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.opentrader.app</id>
  <name>OpenTrader</name>
  <summary>Desktop market charting, screening and technical analysis</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer>
    <name>OpenTrader contributors</name>
  </developer>
  <url type="homepage">https://opentrader.markets/</url>
  <url type="bugtracker">https://github.com/deepentropy/opentrader/issues</url>
  <url type="vcs-browser">https://github.com/deepentropy/opentrader</url>
  <description>
    <p>OpenTrader is a desktop application for market charts and research. It includes technical indicators, screeners, backtesting, bar replay, drawing tools, alerts and scripting.</p>
    <p>Market data is currently delayed by 15 minutes. OpenTrader is for charting and research and is not financial advice.</p>
    <p>Community sign-in and proxy passwords are kept only for the current session unless OpenTrader can use your desktop's Secret Service. To allow storage across launches, run <code>flatpak override --user --talk-name=org.freedesktop.secrets com.opentrader.app</code>. Remove this permission with <code>flatpak override --user --no-talk-name=org.freedesktop.secrets com.opentrader.app</code>.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>Explore market data in the trading dashboard</caption>
      <image>https://raw.githubusercontent.com/deepentropy/opentrader/main/docs/assets/screenshot.png</image>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">com.opentrader.app.desktop</launchable>
  <categories>
    <category>Office</category>
    <category>Finance</category>
  </categories>
  <keywords>
