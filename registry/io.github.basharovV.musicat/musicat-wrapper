#!/bin/sh
set -eu

# Musicat is a Tauri/WebKitGTK application staged by apply_extra under
# /app/extra/usr. It is started from usr/bin so that Tauri finds its sidecar
# (usr/bin/pvr) next to the binary and its resources at ../lib/Musicat. Every
# library it links comes from org.gnome.Platform (webkit2gtk-4.1, gtk-3,
# libsoup-3, javascriptcoregtk-4.1, alsa). Flatpak redirects $HOME, so the
# library index, settings and artwork cache stay in
# ~/.var/app/io.github.basharovV.musicat.

# WebKitGTK's DMABUF renderer paints a blank window under many drivers inside
# the Flatpak sandbox — disabling it is the reliable default for Tauri apps here.
export WEBKIT_DISABLE_DMABUF_RENDERER=1

exec /app/extra/usr/bin/Musicat "$@"
