  <id>io.github.mitcad.Mitcad</id>
  <name>MitCad</name>
  <summary>Parametric 3D CAD with a design history</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.mitcad">
    <name>Mitcad contributors</name>
  </developer>
  <url type="homepage">https://mitcad.org</url>
