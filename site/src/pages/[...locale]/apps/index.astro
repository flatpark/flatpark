---
import Base from '../../../layouts/Base.astro';
import Topbar from '../../../components/Topbar.astro';
import AppCard from '../../../components/AppCard.astro';
import { loadApps, loadCatalog } from '../../../lib/data.mjs';
import { localeOnlyPaths } from '../../../i18n/paths.mjs';
import { getLangFromUrl, useTranslations, sectionLabel } from '../../../i18n';

// Same page in every locale; the chrome around it is what differs.
export const getStaticPaths = localeOnlyPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { repo } = loadCatalog();
const apps = loadApps();
// Default order: newest listing first (the home grid opens on Popular).
// Install counts are optional (the build reads them best-effort), so the
// "Popular" order (total downloads) only appears when there is something to
// order by.
const hasStats = apps.some((a) => a.stats);
const ordered = [...apps].sort((a, b) => (b.added || '').localeCompare(a.added || ''));

// Curated sections present in the catalog, with counts, for the sidebar. The
// slug drives the filter (and stays out of the reader's language); the label is
// what gets shown, and sorting follows the label so the list reads in
// alphabetical order in whichever language that is.
const counts = {};
for (const a of apps) {
  const s = a.section || 'utilities';
  counts[s] = (counts[s] || 0) + 1;
}
const sections = Object.entries(counts)
  .map(([slug, n]) => ({ slug, n, label: sectionLabel(lang, slug) }))
  .sort((a, b) => a.label.localeCompare(b.label, lang));
---

<Base title={t('apps.title', { repo: repo.title })} description={t('apps.meta.description', { count: apps.length, repo: repo.title })}>
  <Topbar repo={repo} />
  <main class="mx-auto max-w-6xl px-5 py-8">
    <div class="grid gap-8 lg:grid-cols-[220px_1fr]">
      <!-- category sidebar -->
      <aside class="lg:sticky lg:top-20 lg:self-start">
        <p class="px-3 pb-2 text-[11px] font-extrabold tracking-widest text-muted uppercase">{t('apps.sidebar.browse')}</p>
        <nav class="flex flex-wrap gap-2 lg:flex-col lg:gap-0.5" data-sections>
          <button class="seg-side is-active" data-section-filter="">
            <span>{t('apps.sidebar.all')}</span><b>{apps.length}</b>
          </button>
          {sections.map((s) => (
            <button class="seg-side" data-section-filter={s.slug}>
              <span>{s.label}</span><b>{s.n}</b>
            </button>
          ))}
        </nav>
      </aside>

      <!-- catalog -->
      <div>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h1 class="text-xl font-extrabold tracking-tight">{t('apps.all')}</h1>
          <select
            data-sort
            aria-label={t('apps.sort.label')}
            class="h-9 rounded-lg border border-line bg-surface px-3 text-sm font-semibold outline-none focus:border-brand"
          >
            <option value="added" selected>{t('apps.sort.added')}</option>
            <option value="updated">{t('apps.sort.recent')}</option>
            {hasStats && <option value="popular">{t('apps.sort.popular')}</option>}
            <option value="approved">{t('apps.sort.approved')}</option>
            <option value="name">{t('apps.sort.name')}</option>
          </select>
        </div>

        <div data-grid class="mt-6 grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-4">
          {ordered.map((app) => <AppCard app={app} />)}
        </div>
        <div
          class="mt-6 rounded-2xl border border-dashed border-line p-12 text-center text-muted"
          data-empty
          hidden
        >
          <h2 class="font-bold text-ink">{t('apps.empty.title')}</h2>
          <p>{t('apps.empty.body')}</p>
        </div>
      </div>
    </div>
  </main>
</Base>
