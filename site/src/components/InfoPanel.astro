---
import { getLangFromUrl, localizePath, packagingDot, packagingText, permissionText, useTranslations } from '../i18n';
const { rows = [], permissions = [], packaging = null } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const dot = {
  safe: 'bg-emerald-500',
  info: 'bg-slate-400',
  caution: 'bg-amber-500',
  warning: 'bg-red-500',
};
const order = { warning: 0, caution: 1, info: 2, safe: 3 };
const sorted = [...permissions]
  .sort((a, b) => (order[a.level] ?? 2) - (order[b.level] ?? 2))
  .map((p) => ({ ...p, ...permissionText(lang, p) }));
const sensitive = permissions.filter((p) => p.level === 'warning' || p.level === 'caution').length;
const packLevel = packaging?.level ?? 'unmodified';
const packItems = (packaging?.items ?? []).map((i) => ({ ...i, ...packagingText(lang, i) }));
---

<div class="flex flex-col gap-5 rounded-2xl border border-line bg-surface p-5">
  {
    rows.length > 0 && (
      <div>
        <h2 class="text-base font-bold">{t('panel.details')}</h2>
        <dl class="mt-3 flex flex-col gap-3 text-sm">
          {rows.map((row) => (
            <div class="flex items-baseline justify-between gap-4">
              <dt class="shrink-0 text-muted">{row.label}</dt>
              <dd class="min-w-0 truncate text-right font-medium" title={row.title}>
                {row.href ? (
                  <a class="text-brand hover:underline" href={row.href}>
                    {row.value}
                  </a>
                ) : (
                  row.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  <div class={rows.length > 0 ? 'border-t border-line pt-5' : ''}>
    <div class="flex items-center justify-between">
      <h2 class="text-base font-bold">{t('panel.permissions')}</h2>
      {
        permissions.length > 0 && (
          <span class="chip">{sensitive > 0 ? t('panel.review', { n: sensitive }) : t('panel.minimal')}</span>
        )
      }
    </div>
    {
      sorted.length === 0 ? (
        <p class="mt-2 text-sm text-muted">{t('panel.none')}</p>
      ) : (
        <ul class="mt-3 flex flex-col gap-3">
          {sorted.map((p) => (
            <li class="flex gap-3">
              <span class={`mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full ${dot[p.level] || 'bg-slate-400'}`} />
              <div class="min-w-0">
                <p class="text-sm font-semibold">{p.label}</p>
                {p.detail ? <p class="text-xs text-muted">{p.detail}</p> : null}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="border-t border-line pt-5">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-bold">{t('panel.packaging')}</h2>
      <span class="chip inline-flex items-center gap-1.5" title={t(`pack.level.${packLevel}.title`)}>
        <span class={`h-2 w-2 rounded-full ${packagingDot[packLevel]}`}></span>{t(`pack.level.${packLevel}`)}
      </span>
    </div>
    {
      packItems.length === 0 ? (
        <p class="mt-2 text-sm text-muted">{t('panel.packaging.none')}</p>
      ) : (
        <ul class="mt-3 flex flex-col gap-3">
          {packItems.map((p) => (
            <li class="flex gap-3">
              <span class={`mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full ${packagingDot[p.level] || 'bg-slate-400'}`} />
              <div class="min-w-0">
                <p class="text-sm font-semibold">{p.label}</p>
                {p.detail ? <p class="text-xs text-muted">{p.detail}</p> : null}
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <a class="mt-3 inline-block text-xs font-semibold text-brand hover:underline" href={localizePath('/trust/#packaging', lang)}>{t('panel.packaging.more')} &rarr;</a>
  </div>
</div>
