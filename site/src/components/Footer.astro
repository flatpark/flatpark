---
import { getLangFromUrl, localizePath, useTranslations } from '../i18n';
import { docUrl, getDocsFor } from '../lib/docs';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The footer points into the docs library: each column names the pages it
// carries by their path under docs/, and takes the titles from the pages
// themselves, so a translated page brings its own label. A path that isn't
// published (yet) is skipped rather than linked dead.
const columns: { name: string; items: (string | { href: string; label: string })[] }[] = [
  {
    name: 'Docs',
    items: ['README', 'users/guide', { href: '/setup/', label: t('nav.setup') }, 'packagers/publishing'],
  },
  { name: 'Project', items: ['project/about', 'project/policies', 'project/trust'] },
  {
    name: 'Community',
    items: ['project/conduct', { href: 'https://github.com/flatpark/flatpark', label: t('footer.github') }],
  },
  { name: 'Legal', items: ['project/legal'] },
];

const docs = new Map((await getDocsFor(lang)).map((d) => [d.base, d]));
const groups = columns.map((c) => ({
  name: c.name,
  items: c.items.flatMap((it) => {
    if (typeof it !== 'string') {
      return [{ href: it.href.startsWith('/') ? localizePath(it.href, lang) : it.href, label: it.label }];
    }
    const doc = docs.get(it);
    if (!doc) return [];
    return [{ href: localizePath(docUrl(it), lang), label: it === 'README' ? t('docs.title') : doc.title }];
  }),
}));
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-10">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      {groups.map((g) => (
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wide text-muted">{t(`footer.group.${g.name}`)}</h3>
          <ul class="mt-3 flex flex-col gap-2 text-sm">
            {g.items.map((it) => (
              <li><a class="text-ink/80 hover:text-brand" href={it.href}>{it.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-8 text-xs text-muted">{t('footer.legal')}</p>
  </div>
</footer>
