---
import { getLangFromUrl, languages, localizePath, locales, stripLang, useTranslations } from '../i18n';
const { repo } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The switcher keeps you on the page you are reading rather than dumping you on
// the home page: same path, different locale prefix.
const basePath = stripLang(Astro.url.pathname);
const langLinks = locales.map((l) => ({
  code: l,
  label: languages[l].label,
  href: localizePath(basePath, l),
  current: l === lang,
}));
---

<header class="sticky top-0 z-20 border-b border-line bg-surface/85 backdrop-blur">
  <!--
    Under 480px the search drops to its own full-width row. On one line it is
    the only child that may shrink, so it absorbs the whole squeeze: the
    controls cost 184px plus 64px of gaps plus 40px of padding, which leaves the
    input 34px at a 320px viewport - less than its own 32px of horizontal
    padding, so nothing you type is visible.

    480px rather than the sm breakpoint on purpose: at 480 the single row still
    gives the input ~143px of text area, which is usable, and wrapping earlier
    than necessary would cost 52px of sticky header height on screens that do
    not need it. At and above 480px this header is unchanged.
  -->
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-3 px-5 py-3 min-[480px]:h-16 min-[480px]:flex-nowrap min-[480px]:py-0"
  >
    <a href={localizePath('/', lang)} class="flex shrink-0 items-center gap-2 font-extrabold tracking-tight">
      <img src="/logo.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <span class="hidden sm:inline">{repo.title}</span>
    </a>

    <!--
      Results drop out of the box itself (see src/scripts/search.js), so the
      search works the same on every page — including app pages, which have no
      grid to filter. The wrapper is the positioning context for that panel and
      the click-outside boundary; the form stays only for the search landmark.
    -->
    <div
      class="relative order-last w-full basis-full min-[480px]:order-none min-[480px]:mx-auto min-[480px]:max-w-md min-[480px]:basis-auto"
      data-search-root
    >
      <form role="search">
        <input
          class="h-10 w-full rounded-full border border-line bg-canvas px-4 text-sm outline-none focus:border-brand focus:bg-surface focus:ring-2 focus:ring-brand/20"
          type="search"
          name="q"
          placeholder={t('nav.search')}
          aria-label={t('nav.search')}
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-results"
          aria-autocomplete="list"
          data-search
        />
      </form>
      <div
        id="search-results"
        role="listbox"
        aria-label={t('nav.search')}
        hidden
        data-search-panel
        class="absolute inset-x-0 top-full z-30 mt-2 max-h-[70vh] overflow-y-auto rounded-2xl border border-line bg-surface py-1 shadow-xl"
      >
      </div>
    </div>

    <button
      type="button"
      data-theme-toggle
      aria-label={t('nav.theme_toggle')}
      title={t('nav.theme_toggle')}
      class="inline-flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg text-muted hover:bg-canvas hover:text-ink"
    >
      <svg class="theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
      <svg class="theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19"></path>
      </svg>
    </button>

    <!--
      Plain <details> rather than a scripted menu: the switcher is the one
      control a reader who landed on the wrong locale needs, so it must work
      before (and without) the bundled script. Anchors keep it crawlable, which
      is also how the alternates get followed.
    -->
    <details class="relative shrink-0" data-lang-menu>
      <summary
        class="inline-flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg text-muted hover:bg-canvas hover:text-ink [&::-webkit-details-marker]:hidden"
        aria-label={t('lang.switch')}
        title={t('lang.switch')}
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"></path>
        </svg>
      </summary>
      <ul class="absolute right-0 z-30 mt-2 min-w-40 rounded-lg border border-line bg-surface py-1 shadow-lg">
        {langLinks.map((l) => (
          <li>
            <a
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              data-lang-pick={l.code}
              aria-current={l.current ? 'true' : undefined}
              class:list={[
                'block px-4 py-2 text-sm hover:bg-canvas',
                l.current ? 'font-semibold text-brand' : 'text-ink/80',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </details>

    <a
      href="https://github.com/flatpark/flatpark"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t('nav.github')}
      title={t('nav.github')}
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-muted hover:bg-canvas hover:text-ink"
    >
      <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
  </div>
</header>
