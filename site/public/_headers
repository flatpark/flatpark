# Cloudflare Pages caching. Hashed assets + fonts never change → cache forever;
# icons are stable per app id; catalog.json should revalidate often.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=86400

# Link-preview cards (src/pages/og/), rebuilt from the icon: same lifetime.
/og/*
  Cache-Control: public, max-age=86400

/catalog.json
  Cache-Control: public, max-age=300, must-revalidate

# The header search index — same deal as the catalog: cheap to revalidate, and
# a stale one would hide apps added by the last publish.
/search-index.json
  Cache-Control: public, max-age=300, must-revalidate

# Atom feeds: readers poll them, and a stale one only delays an announcement.
/feed.xml
  Cache-Control: public, max-age=900, must-revalidate
  Content-Type: application/atom+xml; charset=utf-8

/updates.xml
  Cache-Control: public, max-age=900, must-revalidate
  Content-Type: application/atom+xml; charset=utf-8
